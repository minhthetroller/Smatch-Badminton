# Smatch Badminton Environment Configuration
# Copy this file to .env and fill in your values

# Mapbox Configuration
# Get your token from: https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here

# API Configuration
# Backend API base URL
API_BASE_URL=http://localhost:3000

# Facebook Configuration
# Get your Facebook App ID and Client Token from: https://developers.facebook.com/
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_CLIENT_TOKEN=your_facebook_client_token_here

# Google OAuth Configuration
# Get your Google OAuth client ID from: https://console.cloud.google.com/
GOOGLE_REVERSED_CLIENT_ID=com.googleusercontent.apps.your_client_id_here
